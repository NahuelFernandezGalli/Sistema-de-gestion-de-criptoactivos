# Puerto del servidor
PORT=3000

# Servicio externo de precios de mercado
EXTERNAL_API_BASE_URL=https://api.coingecko.com/api/v3
EXTERNAL_API_TIMEOUT_MS=5000

# Caché de precios (ms). 0 = deshabilitada
PRICE_CACHE_TTL_MS=30000

# Caché de tasas de cambio fiat para CurrencyConversionFilter (ms)
EXCHANGE_RATE_CACHE_TTL_MS=600000

# Logging: error | warn | info | debug
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate limiting del endpoint de mercado
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
