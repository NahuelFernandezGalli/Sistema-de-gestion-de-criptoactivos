# Puerto del servidor
PORT=3000

# Persistencia: database (MySQL + MongoDB) | memory (sin bases, para pruebas rápidas)
PERSISTENCE_DRIVER=database

# MySQL (activos). Credenciales que usa docker-compose para crear la base
MYSQL_DATABASE=crypto_portfolio
MYSQL_USER=crypto
MYSQL_PASSWORD=crypto
MYSQL_ROOT_PASSWORD=root
# Cadena de conexión para correr la API fuera de Docker (en compose se usa el host "mysql")
MYSQL_URI=mysql://crypto:crypto@localhost:3306/crypto_portfolio

# MongoDB (auditoría)
MONGO_DATABASE=crypto_portfolio
# Cadena de conexión para correr la API fuera de Docker (en compose se usa el host "mongo")
MONGO_URI=mongodb://localhost:27017/crypto_portfolio

# Servicio externo de precios de mercado
EXTERNAL_API_BASE_URL=https://api.coingecko.com/api/v3
EXTERNAL_API_TIMEOUT_MS=5000

# Caché de precios (ms). 0 = deshabilitada
PRICE_CACHE_TTL_MS=30000

# Caché de tasas de cambio fiat para CurrencyConversionFilter (ms)
EXCHANGE_RATE_CACHE_TTL_MS=600000

# Logging: error | warn | info | debug
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Umbrales del pipeline de análisis (POST /api/assets/analyze)
ANALYTICS_WHALE_THRESHOLD_USD=100000
ANALYTICS_VOLATILITY_THRESHOLD_PCT=10

# Rate limiting del endpoint de mercado
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
